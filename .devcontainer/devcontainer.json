{
  "name": "Mouchak AI — private full-stack preview",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Mouchak AI website",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "Private API — do not forward",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash scripts/setup-codespace.sh",
  "containerEnv": {
    "MOUCHAK_ENV": "development",
    "ENABLE_DURABLE_INFERENCE": "1",
    "ENABLE_EXPERIMENTAL_POSE": "0",
    "ORT_DISABLE_TELEMETRY": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
