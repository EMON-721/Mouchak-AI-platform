{
  "name": "mouchak-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/dev-platform.mjs",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint app components/mouchak scripts/dev-platform.mjs scripts/next.mjs scripts/platform-config.mjs scripts/test-platform-config.mjs scripts/test-postgres.mjs scripts/legacy-golden.mjs scripts/test-collaboration-postgres.mjs scripts/test-async-postgres.mjs scripts/check-netlify.mjs scripts/test-private-processing.mjs next.config.ts vite.config.ts eslint.config.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "python3 -m pytest tests -q",
    "test:models": "python3 -m pytest tests/test_inference.py -q",
    "build:next": "node scripts/next.mjs build",
    "start:next": "node scripts/next.mjs start",
    "db:migrate": "python3 -m services.model_worker.manage migrate",
    "worker:scheduler": "python3 -m services.model_worker.scheduler",
    "worker:inference": "python3 -m services.model_worker.inference_worker",
    "test:transport": "node scripts/test-private-processing.mjs",
    "build:sites": "node scripts/run-framework.mjs build",
    "start:sites": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:portable": "node scripts/test-platform-config.mjs",
    "check:public": "python3 scripts/check-public-source.py",
    "docs:api": "python3 scripts/generate-api-reference.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
