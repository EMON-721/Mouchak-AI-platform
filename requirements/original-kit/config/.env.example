# EXAMPLE ONLY. Never commit real secrets.
NEXT_PUBLIC_APP_NAME=JibonSetu AI
NEXT_PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jibonsetu
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
# Optional Google OAuth for one unified login
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Object storage for user-owned documents; private buckets only
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Python model service is separately deployed, route accessed through central backend
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_SHARED_SECRET=
# OFF by default; do not send sensitive documents to unapproved providers
ALLOW_EXTERNAL_INFERENCE=false
ENABLE_DEMO_DATA=true
PUBLIC_ENABLE_NEW_USER_SIGNUP=true
