FROM python:3.12-slim
ENV ORT_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_TELEMETRY=1 MOUCHAK_STATE_DIR=/app/state MODEL_DIR=/app/models
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ben tesseract-ocr-eng ffmpeg clamav libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-python.txt ./
RUN pip install --no-cache-dir -r requirements-python.txt
COPY services ./services
COPY packages ./packages
COPY data ./data
COPY requirements ./requirements
COPY database ./database
COPY deploy/*.sql ./deploy/
COPY public/fonts ./public/fonts
COPY scripts/download-models.py scripts/download-pose.py ./scripts/
COPY docs/audit/model-downloads.json docs/audit/pose-assets.json ./docs/audit/
RUN useradd --uid 10001 --create-home mouchak && mkdir -p state models && chown -R mouchak:mouchak state models
USER mouchak
EXPOSE 8000
CMD ["python","-m","services.model_worker.serve"]
