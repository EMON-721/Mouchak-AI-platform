# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
# Mouchak private runtime data and model binaries
/.venv/
/.state/
**/__pycache__/
.pytest_cache/
/models/
*.db
*.sqlite*
*.key
!/.env.example
!/requirements/**/.env.example
# Local test fixtures and generated media
/tests/generated/
# Do not accidentally publish dependency installation reports or archives
*.zip

# Encrypted recovery archives are still private operator data.
*.mouchak
/backups/
