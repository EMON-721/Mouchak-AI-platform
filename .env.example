# Development uses encrypted local SQLite explicitly; never a production fallback.
MOUCHAK_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PRIVATE_API_URL=http://127.0.0.1:8000
# Production: managed PostgreSQL, TLS, separate migration owner and app role.
DATABASE_URL=sqlite:///.state/development.db
# Production replacement: postgresql+psycopg://mouchak_app:REPLACE@postgres:5432/mouchak?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
# Generate once with Fernet.generate_key(). Keep in your runtime secret store.
DATA_ENCRYPTION_KEY=
PRIVATE_API_TOKEN=
MODEL_DIR=models
MOUCHAK_STATE_DIR=.state
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
REDIS_URL=
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=path
# Private CA endpoints need an operator-owned read-only CA mount and AWS_CA_BUNDLE.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=90

# Dedicated worker role; never grant this role to the web/API database role.
SCHEDULER_DATABASE_URL=
SCHEDULER_POLL_SECONDS=15
# Store independently from DATA_ENCRYPTION_KEY for encrypted recovery archives.
BACKUP_ENCRYPTION_KEY=

# Account-free visitor scope lifetime, capped at 24 hours.
ANONYMOUS_SESSION_TTL_SECONDS=86400
VISITOR_RETENTION_POLL_SECONDS=60
# Local/staging experimental pose observations only; always disabled in production.
ENABLE_EXPERIMENTAL_POSE=0
# Also enforced before model-runtime imports; no inference telemetry consent assumed.
ORT_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_TELEMETRY=1

# Netlify website + dedicated Linux backend. Never NEXT_PUBLIC_ prefix secrets.
ENABLE_DURABLE_INFERENCE=0
INFERENCE_DATABASE_URL=
RETENTION_DATABASE_URL=
API_HOSTNAME=
TLS_EMAIL=
AWS_DEFAULT_REGION=
